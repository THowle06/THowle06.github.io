---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillsBlock from "../components/SkillsBlock.astro";
import AcademicGrid from "../components/AcademicGrid.astro";
import { projects } from "../data/portfolio";
---

<BaseLayout title="Tyler - Software Engineer & Backend Developer">
  <main class="space-y-16">
    <Hero />

    <section class="space-y-4">
      <h2
        class="text-xs uppercase tracking-wider text-zinc-400 font-mono font-medium"
      >
        Engineered Projects
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((proj) => <ProjectCard project={proj} />)}
      </div>
    </section>

    <SkillsBlock />

    <AcademicGrid />

    <footer
      class="pt-8 border-t border-zinc-800/80 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-zinc-500 font-mono"
    >
      <span>Tyler Howle· University of Nottingham</span>
      <span>Built with Astro & Tailwind</span>
    </footer>
  </main>
</BaseLayout>
