---
import { personalInfo } from "../data/portfolio";
---

<header class="space-y-5">
  <div
    class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-900/60 text-xs text-zinc-300 backdrop-blur-md"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    {personalInfo.status}
  </div>

  <div class="space-y-1.5">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white">
      {personalInfo.name}
    </h1>
    <p class="text-sm font-mono text-zinc-300">
      {personalInfo.education}
    </p>
  </div>

  <p class="text-zinc-300 leading-relaxed max-2-2xl text-base">
    {personalInfo.bio}
  </p>

  <div class="flex flex-wrap items-center gap-3 pt-2 text-sm font-medium">
    <a
      href={personalInfo.links.email}
      class="px-4 py-2 rounded-lg bg-zinc-100 text-zinc-950 hover:bg-white transition"
    >
      Email me
    </a>
    <a
      href="/public/Tyler-Howle-CV.pdf"
      target="_blank"
      rel="noreferrer"
      class="px-4 py-2 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-800 transition text-zinc-300"
    >
      Resume / CV ↗
    </a>
    <a
      href={personalInfo.links.github}
      target="_blank"
      rel="noreferrer"
      class="px-4 py-2 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-800 transition text-zinc-300"
    >
      GitHub ↗
    </a>
    <a
      href={personalInfo.links.linkedin}
      target="_blank"
      rel="noreferrer"
      class="px-4 py-2 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-800 transition text-zinc-300"
    >
      LinkedIn ↗
    </a>
  </div>
</header>
