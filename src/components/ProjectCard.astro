---
import type { Project } from "../data/portfolio";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="p-6 rounded-2xl border border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-700/80 hover:bg-zinc-900/50 transition flex flex-col justify-between space-y-4"
>
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="font-semibold text-lg text-zinc-100">{project.title}</h3>
        {
          project.role && (
            <p class="text-xs font-mono text-zinc-500 mt-0.5">{project.role}</p>
          )
        }
      </div>
      {
        project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noreferrer"
            class="text-xs font-mono text-zinc-400 hover:text-white transition"
          >
            Code ↗
          </a>
        )
      }
    </div>

    <p class="text-sm text-zinc-300 leading-relaxed">{project.description}</p>

    <ul class="space-y-1.5 pt-1">
      {
        project.highlights.map((point) => (
          <li class="text-xs text-zinc-400 flex items-start gap-2">
            <span class="text-zinc-600 font-bold">•</span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex flex-wrap gap-1.5 pt-2">
    {
      project.tech.map((t) => (
        <span class="text-xs px-2.5 py-0.5 rounded-md bg-zinc-800/60 text-zinc-300 border border-zinc-800 font-mono">
          {t}
        </span>
      ))
    }
  </div>
</article>
