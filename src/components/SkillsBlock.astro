---
import { skills } from "../data/portfolio";
---

<section class="space-y-4">
  <h2
    class="text-xs uppercase tracking-wider text-zinc-400 font-mono font-medium"
  >
    Technical Toolkit
  </h2>

  <div class="space-y-3">
    <div>
      <span class="text-xs text-zinc-500 font-mono block mb-1.5">Languages</span
      >
      <div class="flex flex-wrap gap-1.5">
        {
          skills.languages.map((item) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-300 font-mono">
              {item}
            </span>
          ))
        }
      </div>
    </div>

    <div>
      <span class="text-xs text-zinc-500 font-mono block mb-1.5"
        >Backend & Storage</span
      >
      <div class="flex flex-wrap gap-1.5">
        {
          skills.backend.map((item) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800/80 text-zinc-300 font-mono">
              {item}
            </span>
          ))
        }
      </div>
    </div>

    <div>
      <span class="text-xs text-zinc-500 font-mono block mb-1.5"
        >DevOps & Systems</span
      >
      <div class="flex flex-wrap gap-1.5">
        {
          skills.infrastructure.map((item) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800/80 text-zinc-300 font-mono">
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
